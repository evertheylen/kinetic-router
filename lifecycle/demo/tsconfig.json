{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@kinetic-router/lifecycle": ["../src/index.ts"],
      "@kinetic-router/animations": ["../../animations/src/index.ts"],
      "@kinetic-router/layout": ["../../layout/src/index.ts"]
    },
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "include": ["*.tsx", "*.ts", "../src/**/*.ts"],
  "exclude": ["../src/**/*.test.ts", "../src/**/*.test.tsx"]
}
